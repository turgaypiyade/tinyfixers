rules_version = '2';

// TinyFixers Firestore güvenlik kuralları (Docs/ProductionPlan.md P2).
// Deploy: Firebase Console → Firestore Database → Rules → bu dosyayı yapıştır → Publish
// (veya `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cloud save: yalnız sahibi okur/yazar ─────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Liderlik skorları: herkes okur; yalnız sahibi, doğrulanmış alanlarla yazar ──
    match /leaderboards/{board}/scores/{uid} {
      allow read: if true;
      // Hesap silme (AccountDeletionService): sahibi kendi skorunu siler.
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score < 100000000;
    }

    // ── Oyuncu dizini (P3 — ID arama/profil): herkes okur, sahibi yazar ──
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Takımlar (P3): okuma herkes; yazma auth'lu (P3'te üyelik kontrolüyle sıkılaşacak) ──
    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if request.auth != null;

      match /members/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /chat/{msgId} {
        allow read: if true;
        // Hesap silme: gönderen kendi mesajlarını siler.
        allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
      }

      // Can isteği: her oyuncunun takımda tek aktif isteği (doküman id = kendi uid).
      match /lifeRequests/{uid} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == uid;   // hesap silme
        // Sahibi: yeni istek (yardımcılar boş, sunucu zamanı).
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['requesterId','requesterName','needed','helpers','createdAt'])
          && request.resource.data.requesterId == uid
          && request.resource.data.requesterName is string && request.resource.data.requesterName.size() <= 80
          && request.resource.data.needed is int
          && request.resource.data.needed >= 1 && request.resource.data.needed <= 5
          && request.resource.data.helpers is map && request.resource.data.helpers.size() == 0
          && request.resource.data.createdAt == request.time;
        // Takım arkadaşı yardımı: yalnız kendi uid'ini helpers'a bir kez ekler.
        allow update: if request.auth != null && request.auth.uid != uid
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpers'])
          && request.resource.data.helpers.diff(resource.data.helpers).addedKeys().hasOnly([request.auth.uid])
          && request.resource.data.helpers.diff(resource.data.helpers).changedKeys().size() == 0
          && request.resource.data.helpers.diff(resource.data.helpers).removedKeys().size() == 0
          && request.resource.data.helpers[request.auth.uid] is string
          && request.resource.data.helpers[request.auth.uid].size() <= 80
          && request.resource.data.helpers.size() <= resource.data.needed
          && request.time < resource.data.createdAt + duration.value(24, 'h');
      }
    }

    // ── Sohbet şikâyetleri (ChatModeration.Report): oyuncu yalnız oluşturur; okuma Console'dan ──
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterId','reportedId','reportedName','teamId','messageId','text','kind','createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 600;
      allow read, update, delete: if false;
    }

    // ── Uzaktan oyun ayarı (LevelRemoteTuning): herkes okur, yalnız Console'dan yazılır ──
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Gear Cup: every real team has one immutable five-slot race assignment per season.
    // Receipts atomically update personal, team and slot totals; retries cannot count twice.
    match /gearCupSeasons/{season} {
      function signedIn() { return request.auth != null; }
      function memberOf(teamId) {
        return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      }
      function player(uid) { return /databases/$(database)/documents/gearCupSeasons/$(season)/players/$(uid); }
      function team(id) { return /databases/$(database)/documents/gearCupSeasons/$(season)/teams/$(id); }
      function raceSlot(group, slot) {
        return /databases/$(database)/documents/gearCupSeasons/$(season)/groups/$(string(group))/slots/$(string(slot));
      }
      function settings() {
        return exists(/databases/$(database)/documents/config/gearcup)
          ? get(/databases/$(database)/documents/config/gearcup).data : {};
      }
      function grace() { return duration.value(settings().get('settlementMinutes', 10), 'm'); }
      function openWindow(d) {
        return d.startAt is timestamp && d.endAt is timestamp && request.time >= d.startAt && request.time < d.endAt
          && d.endAt - d.startAt >= duration.value(1, 'h') && d.endAt - d.startAt <= duration.value(168, 'h');
      }
      function scoreUpdate(teamId) {
        let receiptId = request.resource.data.lastReceipt;
        let receipt = /databases/$(database)/documents/gearCupSeasons/$(season)/wins/$(receiptId);
        let win = getAfter(receipt).data;
        return memberOf(teamId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'lastReceipt'])
          && !exists(receipt) && win.uid == request.auth.uid && win.teamId == teamId
          && request.resource.data.score == resource.data.score + win.amount;
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['nextSlot', 'lastTeamId'])
        && request.resource.data.nextSlot == 1 && memberOf(request.resource.data.lastTeamId)
        && getAfter(team(request.resource.data.lastTeamId)).data.group == 0
        && getAfter(team(request.resource.data.lastTeamId)).data.slot == 0;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['nextSlot', 'lastTeamId'])
        && request.resource.data.nextSlot == resource.data.nextSlot + 1
        && memberOf(request.resource.data.lastTeamId) && !exists(team(request.resource.data.lastTeamId))
        && getAfter(team(request.resource.data.lastTeamId)).data.group == int(resource.data.nextSlot / 5)
        && getAfter(team(request.resource.data.lastTeamId)).data.slot == resource.data.nextSlot % 5;

      match /teams/{teamId} {
        allow read: if signedIn();
        allow create: if memberOf(teamId) && openWindow(request.resource.data)
          && request.resource.data.keys().hasOnly(['teamId','name','emblem','group','slot','score','startAt','endAt'])
          && request.resource.data.teamId == teamId && request.resource.data.score == 0
          && request.resource.data.name == get(/databases/$(database)/documents/teams/$(teamId)).data.name
          && request.resource.data.emblem is int && request.resource.data.group is int
          && request.resource.data.group >= 0 && request.resource.data.group < 100000
          && request.resource.data.group == int((getAfter(/databases/$(database)/documents/gearCupSeasons/$(season)).data.nextSlot - 1) / 5)
          && request.resource.data.slot == (getAfter(/databases/$(database)/documents/gearCupSeasons/$(season)).data.nextSlot - 1) % 5;
        allow update: if scoreUpdate(teamId);
      }
      match /groups/{group}/slots/{slot} {
        allow read: if signedIn();
        allow create: if memberOf(request.resource.data.teamId) && openWindow(request.resource.data)
          && group == string(request.resource.data.group) && slot == string(request.resource.data.slot)
          && !exists(team(request.resource.data.teamId))
          && request.resource.data == getAfter(team(request.resource.data.teamId)).data;
        allow update: if scoreUpdate(resource.data.teamId)
          && request.resource.data == getAfter(team(resource.data.teamId)).data;
      }
      match /players/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == request.auth.uid && memberOf(request.resource.data.teamId)
          && openWindow(request.resource.data)
          && request.resource.data.keys().hasOnly(['teamId','name','group','slot','score','startAt','endAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.score == 0
          && request.resource.data.group == getAfter(team(request.resource.data.teamId)).data.group
          && request.resource.data.slot == getAfter(team(request.resource.data.teamId)).data.slot
          && request.resource.data.startAt == getAfter(team(request.resource.data.teamId)).data.startAt
          && request.resource.data.endAt == getAfter(team(request.resource.data.teamId)).data.endAt;
        allow update: if signedIn() && uid == request.auth.uid && scoreUpdate(resource.data.teamId);
      }
      match /wins/{winId} {
        allow read: if signedIn() && winId.matches(request.auth.uid + '_[a-f0-9]{32}');
        allow create: if signedIn() && winId.matches(request.auth.uid + '_[a-f0-9]{32}')
          && request.resource.data.keys().hasOnly(['uid','teamId','amount','level','wonAt','createdAt'])
          && request.resource.data.uid == request.auth.uid && memberOf(request.resource.data.teamId)
          && request.resource.data.amount is int && request.resource.data.amount > 0
          && request.resource.data.amount <= settings().get('maxGearsPerLevel', 10000)
          && request.resource.data.level is int && request.resource.data.level > 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.wonAt is timestamp
          && request.resource.data.wonAt >= get(player(request.auth.uid)).data.startAt
          && request.resource.data.wonAt <= get(player(request.auth.uid)).data.endAt
          && request.resource.data.wonAt <= request.time + duration.value(2, 'm')
          && request.time < get(player(request.auth.uid)).data.endAt + grace()
          && getAfter(player(request.auth.uid)).data.lastReceipt == winId
          && getAfter(player(request.auth.uid)).data.score == get(player(request.auth.uid)).data.score + request.resource.data.amount
          && getAfter(team(request.resource.data.teamId)).data.lastReceipt == winId
          && getAfter(team(request.resource.data.teamId)).data.score == get(team(request.resource.data.teamId)).data.score + request.resource.data.amount
          && getAfter(raceSlot(get(player(request.auth.uid)).data.group, get(player(request.auth.uid)).data.slot)).data.score
             == getAfter(team(request.resource.data.teamId)).data.score;
      }
      match /claims/{uid} {
        function botFinal(group, slot) { return 4000 + (group * 1103 + slot * 1801 + 7619) % 10001; }
        function better(group, slot, ownSlot, ownScore) {
          let path = raceSlot(group, slot);
          let score = exists(path) ? get(path).data.score : botFinal(group, slot);
          return score > ownScore || (score == ownScore && slot < ownSlot) ? 1 : 0;
        }
        function finalRank(p) {
          let own = get(raceSlot(p.group, p.slot)).data.score;
          return 1 + better(p.group, 0, p.slot, own) + better(p.group, 1, p.slot, own)
            + better(p.group, 2, p.slot, own) + better(p.group, 3, p.slot, own) + better(p.group, 4, p.slot, own);
        }
        function validClaim() {
          let p = get(player(uid)).data;
          let rank = finalRank(p);
          let eligible = p.score > 0 && rank <= 3;
          let cfg = settings();
          return request.time >= p.endAt + grace() && request.resource.data.rank == rank
            && request.resource.data.keys().hasOnly(['rank','coins','item','amount','createdAt'])
            && request.resource.data.createdAt == request.time
            && request.resource.data.coins == (eligible ? cfg.get('rewardCoins', [1000,500,250])[rank-1] : 0)
            && request.resource.data.item == (eligible ? cfg.get('rewardItems', [11,10,20])[rank-1] : 99)
            && request.resource.data.amount == (eligible ? cfg.get('rewardAmounts', [2,1,1])[rank-1] : 0);
        }
        allow read: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn() && uid == request.auth.uid && validClaim();
      }
    }

    // Kalan her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
