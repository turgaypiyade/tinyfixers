// Wondi Games sitesi — Cloudflare Worker (statik dosyalar; worker.js yalnız video yollarında Range/206 için). Yayın: Website/ içinde
//   set -a; . ~/.wondi-cloudflare.env; set +a; npx wrangler@4 deploy
// build adımı (build.py): index.html + /tr/ + img/ + robots.txt + sitemap.xml → .wrangler/site; ham kareler (raw/, IMGStore/) asla yüklenmez.
{
  "name": "wondigames",
  "compatibility_date": "2026-10-14",
  "build": {
    "command": "python3 build.py"
  },
  "main": "worker.js",
  "assets": {
    "directory": ".wrangler/site",
    "binding": "ASSETS",
    "run_worker_first": ["/img/clips/*", "/social/reels/*", "/api/launch-list*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LAUNCH_LIST", "class_name": "LaunchWaitlist" }]
  },
  "migrations": [{ "tag": "v1-launch-list", "new_sqlite_classes": ["LaunchWaitlist"] }],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "wondigames.com", "custom_domain": true },
    { "pattern": "www.wondigames.com", "custom_domain": true }
  ]
}
